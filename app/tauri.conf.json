{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vorto",
  "mainBinaryName": "vorto",
  "identifier": "app.vorto.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Vorto",
        "url": "index.html",
        "width": 1080,
        "height": 720,
        "minWidth": 820,
        "minHeight": 580,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      },
      {
        "label": "hud",
        "title": "Vorto indicator",
        "url": "index.html#hud",
        "width": 620,
        "height": 220,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "flash",
        "title": "Vorto highlight",
        "url": "index.html#flash",
        "width": 200,
        "height": 80,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Edgar Kessler",
    "copyright": "Copyright (c) 2026 Edgar Kessler. MIT License.",
    "homepage": "https://github.com/edgar-kessler/vorto",
    "category": "Productivity",
    "shortDescription": "Local dictation for Windows",
    "licenseFile": "../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFOUY1NTQ5NzREMzM4RDcKUldUWE9OTjBTVldmN3JEYlladTNVbTZVcWgwSUZaWE9qYTQ0UkJ4YmhlOVJkOC9sRTBPNEFSRnkK",
      "endpoints": ["https://github.com/edgar-kessler/vorto/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
